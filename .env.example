# Chaves de API necessárias para o Weather AI Agent
# Copie este arquivo para um novo chamado '.env' e configure seus valores reais.

# Chave de API do Groq Cloud (Obtenha em: https://console.groq.com/)
GROQ_API_KEY="sua_chave_groq_aqui"

# Modelo do Groq de sua escolha (Exemplos: llama3-8b-8192, llama-3.1-70b-versatile, mixtral-8x7b-32768)
MODEL="openai/gpt-oss-120b"

# (Opcional) Chave da OpenWeatherMap API para quando integrar com a API de clima real
# OPENWEATHER_API_KEY="sua_chave_openweathermap_aqui"
